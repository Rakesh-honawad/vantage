# Copy to .env.local and fill in. Never commit real keys.
# Public address of the site. Used in the sitemap, robots file and search markup.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-secret-key

# Seed script only
DEMO_PASSWORD=choose-a-long-password

# Scheduled publishing: the cron route needs this as a Bearer token
CRON_SECRET=a-long-random-string

# AI assist (optional). Without a key the inbox still works and reads enquiries with built-in rules.
# Free Gemini key, no card: https://aistudio.google.com  ->  Get API key
GEMINI_API_KEY=
# Or Grok (xAI). Only use one of the two.
XAI_API_KEY=
# Optional: AI_PROVIDER=gemini | grok   AI_MODEL=...   AI_BASE_URL=... (any OpenAI-compatible service)
AI_PROVIDER=
AI_MODEL=
AI_BASE_URL=
